# Normalise line endings so a contributor on Windows cannot open a PR that is 90%
# CRLF churn. The registry drift check in CI compares generated JSON byte for byte,
# so this is load-bearing, not cosmetic.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary

# Generated by `shadcn build`. Collapse it in PR diffs so review stays on the source.
public/r/*.json linguist-generated=true

package-lock.json linguist-generated=true

# Not the product. Keeps the language bar on GitHub honest.
docs/**       linguist-documentation=true
.claude/**    linguist-vendored=true
.agents/**    linguist-vendored=true
