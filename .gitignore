# Dependencies
/node_modules

# This repo is npm-only: package-lock.json is committed and CI runs `npm ci`.
# A second lockfile would silently resolve a different tree than CI does.
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb

# Next.js
/.next/
/out/
next-env.d.ts

# NOTE: public/r/ is generated by `shadcn build` but is deliberately NOT ignored.
# The registry JSON is the distribution (docs/REGISTRY.md), and CI rebuilds it and
# diffs it to catch stale items. Ignoring it would ship last week's code to users.

# Environment. An .env.example, if one is ever added, stays committed.
.env*
!.env.example

# Keys and certificates
*.pem

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.log*

# Claude Code. agents/, commands/ and skills/ are part of the repo kit and are
# committed on purpose — only the per-machine settings file is local.
.claude/settings.local.json

# Each worktree holds a full checkout of the repo.
/.claude/worktrees/

# Editors
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
